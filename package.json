    "rollback": "bash scripts/rollback.sh",
    "images:create-test": "node scripts/create-test-image.js",
    "images:optimize": "node scripts/optimize-images.js",
    "images:optimize:ci": "npm run images:create-test && npm run images:optimize",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
